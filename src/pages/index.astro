---
/**
 * HOME. The seed's home sections in order (hero, services overview, why
 * choose us, areas covered, contact) on the approved preview 2 look: hero
 * (two CTAs, trust bullets) → trust strip in the reviews slot (no reviews
 * exist) → the nine services → why choose us (the plan's first three USPs
 * lead: the try-before-you-buy showroom, wood-fired heat-up, the Arctic
 * dealer) → CTA band → commercial spas → trade band → gallery → areas → form.
 * Hot tubs lead the headline, title and nav. No reviews, no brand logos.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Feature from '../components/Feature.astro';
import CtaBand from '../components/CtaBand.astro';
import TradeBand from '../components/TradeBand.astro';
import Gallery from '../components/Gallery.astro';
import AreasCovered from '../components/AreasCovered.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { seo, manufacturerLine, customersLine } from '../data/site';
import { picks, pick } from '../lib/media';

const hero = picks('home', 4);
const wood = pick('wood-fired-hot-tubs', 0);
const arctic = pick('arctic-spas-dealer', 0);
const mosaic = pick('commercial-and-mosaic-tiled-spas', 0);
const trade = pick('trade-and-holiday-park-hot-tubs', 0);
const showroom = pick('home', 1);
---

<Base title={seo.title} description={seo.description} page="home" ogImage={hero[0].full ?? hero[0].src}>
  <Hero
    h1="Not sure which hot tub to buy? Try one first at Cumbria Spas"
    lead="Wood-fired hot tubs that heat in about 2 to 4 hours, electric hot tubs, Arctic Spas, saunas, swim spas and mosaic-tiled spas, with hot tub repair and servicing. Try before you buy at the showroom in Kirkby In Furness."
    slides={hero.map((im) => ({ src: im.src, alt: im.alt }))}
    trust={['Try-before-you-buy showroom', 'Wood-fired tubs hot in 2 to 4 hours', 'Arctic Spas dealer', 'Established in 2013']}
  />

  <TrustStrip />

  <ServicesGrid
    heading="Hot tubs, spas, saunas and pools, sold, installed and serviced"
    lead={`Wood-fired and electric hot tubs lead the range, alongside saunas, swim spas, Arctic Spas and commercial mosaic-tiled spas. ${customersLine}`}
  />

  <Feature
    id="try-before-you-buy"
    heading="Try a hot tub at the showroom before you buy"
    body={[
      'Cumbria Spas has a try-before-you-buy hot tub showroom at Kirkby In Furness, so you can sit in a tub before you choose one.',
      'Not able to visit? Buyers get videos and photos of the actual tub, its buttons and its lights on WhatsApp, so the decision is made with all the information.',
    ]}
    points={[
      { h: 'Established in 2013', p: 'Hot tubs delivered to customers throughout the UK.' },
      { h: 'Residential and commercial', p: 'Homes, holiday parks, hotels, spas and leisure centres.' },
    ]}
    image={showroom.src}
    full={showroom.full}
    imageAlt={showroom.alt}
    cta="Ask to Try a Hot Tub"
  />

  <Feature
    id="wood-fired"
    tone="tint"
    flip
    heading="Wood-fired hot tubs, hot in about 2 to 4 hours"
    body={[
      'A wood-fired tub heats in about 2 to 4 hours, against 14 to 16 hours for an electric tub. The model most buyers choose has hydrotherapy jets and LED lights, run from a standard 13-amp socket; the stove does the heating.',
      `${manufacturerLine} See <a href="/wood-fired-hot-tubs/">wood-fired hot tubs</a> for the range.`,
    ]}
    points={[
      { h: 'Stove-heated', p: 'Open the vent to draw heat, shut it to slow it.' },
      { h: 'Off-grid model', p: 'No electricity at all, for lodges and glamping sites.' },
    ]}
    image={wood.src}
    full={wood.full}
    imageAlt={wood.alt}
    cta="Ask About Wood-Fired Hot Tubs"
  />

  <Feature
    id="arctic-spas"
    heading="An Arctic Spas dealer, installing with Arctic's own engineer"
    body={[
      'Cumbria Spas is an Arctic Spas dealer: it sells, supplies, installs and maintains Arctic Spas, and every one is installed with one of Arctic\'s own engineers.',
      'Ask about Spa Boy, the Arctic saltwater water care system that analyses the water and adjusts sanitisation automatically. See <a href="/arctic-spas-dealer/">Arctic Spas from Cumbria Spas</a>.',
    ]}
    image={arctic.src}
    full={arctic.full}
    imageAlt={arctic.alt}
    cta="Ask About Arctic Spas"
  />

  <CtaBand
    heading="Find the right hot tub before you choose"
    line="Tell us how you plan to use your hot tub, and Cumbria Spas will help you choose."
    image={(hero[1] ?? hero[0]).src}
    imageAlt={(hero[1] ?? hero[0]).alt}
  />

  <Feature
    id="commercial"
    tone="tint"
    flip
    heading="Commercial and mosaic-tiled spas, plant room included"
    body={[
      'GRP mosaic-tiled spas and hydro spas for hotels, spa-day venues, leisure centres and homes, with plant rooms, automated dosing and glass filtration installed by Cumbria Spas itself. Bespoke spas are designed to fit the space, with CAD drawings.',
      'Hot tubs already in? Cumbria Spas repairs and services residential and commercial hot tubs, plant rooms included: see <a href="/hot-tub-repair-and-servicing/">hot tub repair and servicing</a>.',
    ]}
    points={[
      { h: 'Water-tested for 24 hours', p: 'Every spa signed off only with no leaks.' },
      { h: 'Glass filtration', p: 'Changed about every ten years, against about two for sand.' },
    ]}
    image={mosaic.src}
    full={mosaic.full}
    imageAlt={mosaic.alt}
    cta="Ask About Commercial Spas"
  />

  <TradeBand
    heading="Trade prices for holiday parks and lodge sites"
    body={[
      'Cumbria Spas has supplied and serviced many holiday parks. A British company, VAT registered, ordering at least three units buys the Kubilų pasaulis range at trade prices; hot tubs and saunas can be mixed.',
      'Delivered to your site, with servicing afterwards if you want it. See <a href="/trade-and-holiday-park-hot-tubs/">trade and holiday park hot tubs</a>.',
    ]}
    chips={['Holiday parks', 'Lodge sites', 'Glamping sites', 'Letting businesses']}
    image={trade.src}
    imageAlt={trade.alt}
  />

  <Gallery />

  <AreasCovered />

  <QuoteForm
    heading="Ask about a hot tub, spa or sauna"
    lead="Tell us what you are looking for and where it will go, and Cumbria Spas will come back to you with prices."
  />
</Base>
