---
/**
 * THANK YOU (noindex). Formlane redirects here after a submission, passing
 * the first name (?name=). Anatomy (law): the hero, the confirmation, the
 * map; no second form, CTA band or gallery, and no reviews (none exist).
 */
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { business } from '../data/site';
---

<Base title="Enquiry Sent | Cumbria Spas" description="Thanks for your enquiry to Cumbria Spas. We will get back to you about your hot tub, spa, sauna or service." page="thank-you" utility={true} noindex={true}>
  <LegalPage h1="Thanks, your enquiry has reached Cumbria Spas" lead="Cumbria Spas will be in touch soon. Here is how to reach us in the meantime." kind="thank-you">
    <p data-thanks-name hidden></p>
    <h2>Want to talk now?</h2>
    <ul>
      <li>Call <a href={business.phoneHref}>{business.phone}</a></li>
      <li>Message <a href={business.whatsapp} target="_blank" rel="noopener">Cumbria Spas on WhatsApp</a></li>
    </ul>
    <h2>The showroom</h2>
    <p>{business.address}. Want to try a hot tub before you buy? Just ask when Cumbria Spas gets back to you.</p>
    <MapEmbed query={business.mapQuery} label={`the Cumbria Spas showroom, ${business.town}`} zoom={12} />
    <p>Or go back to the <a href="/">Cumbria Spas home page</a>.</p>
  </LegalPage>
</Base>

<script>
  const name = new URLSearchParams(location.search).get('name')?.trim().split(/\s+/)[0];
  const el = document.querySelector<HTMLElement>('[data-thanks-name]');
  if (name && el && /^[\p{L}'-]{1,40}$/u.test(name)) { el.textContent = `Thanks, ${name}.`; el.hidden = false; }
</script>
