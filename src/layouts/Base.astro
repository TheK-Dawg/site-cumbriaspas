---
/**
 * Root layout. Head (canonical on the client's domain, OG, ONE JSON-LD graph
 * around the one LocalBusiness node at <origin>/#business per the ENTITY-SAMEAS
 * law, plus page nodes), header, footer, the one root-mounted Lightbox, the
 * mobile sticky bar, the floating WhatsApp button, the motion wiring and the
 * Quick Quote anchor law.
 *
 * Indexing: this build runs on the preview2 workers.dev host until the domain
 * moves, so every page is noindex unless PUBLIC_INDEXABLE=1 at build time (set
 * it at go-live on cumbriaspas.co.uk; thank-you and 404 stay noindex always).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { business, hubs, hubHref, seo, entity, serviceCoverage } from '../data/site';
import towns from '../data/towns.json';

interface Crumb { name: string; href?: string }
interface Props {
  title?: string;
  description?: string;
  page?: string;
  utility?: boolean; // thank-you / 404: no sticky bar
  noindex?: boolean;
  noSchema?: boolean; // the 404 carries no entity graph
  schema?: Record<string, unknown>[]; // extra @graph nodes
  crumbs?: Crumb[];
  ogImage?: string;
}
const { title = seo.title, description = seo.description, page = 'page', utility = false, noindex = false, noSchema = false, schema = [], crumbs = [], ogImage = '/images/new-20top-20image.jpg' } = Astro.props;
const indexable = import.meta.env.PUBLIC_INDEXABLE === '1' && !noindex;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = /^https?:/.test(ogImage) ? ogImage : new URL(ogImage, Astro.site).href;
const origin = business.url;

// The one business node. sameAs: none verified yet (no GBP, Facebook page or
// company number on file): ships empty, listed as operator questions.
const sameAs = [
  ...(entity.gbpPlaceId ? [`https://www.google.com/maps/place/?q=place_id:${entity.gbpPlaceId}`] : []),
  ...entity.sameAs,
  ...(entity.companyNumber ? [`https://find-and-update.company-information.service.gov.uk/company/${entity.companyNumber}`] : []),
];
const businessNode: Record<string, unknown> = {
  '@type': entity.type,
  '@id': `${origin}/#business`,
  name: business.name,
  legalName: business.legalName,
  description: seo.description,
  url: `${origin}/`,
  telephone: '+44 7445 450908',
  image: new URL('/images/square.jpg', Astro.site).href,
  logo: new URL('/images/square.jpg', Astro.site).href,
  foundingDate: String(business.founded),
  address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.town, addressRegion: business.region, postalCode: business.postcode, addressCountry: 'GB' },
  areaServed: [serviceCoverage, ...towns.map((t) => t.town)].map((name) => ({ '@type': 'Place', name })),
  knowsAbout: hubs.map((h) => h.name),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Hot tubs, spas, saunas, pools and hot tub servicing',
    itemListElement: hubs.map((h) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: h.name, url: `${origin}${hubHref(h.slug)}` } })),
  },
  ...(sameAs.length ? { sameAs } : {}),
};
const graph: Record<string, unknown>[] = [
  businessNode,
  { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: business.name, publisher: { '@id': `${origin}/#business` }, inLanguage: 'en-GB' },
  { '@type': 'WebPage', '@id': pageUrl, url: pageUrl, name: title, description, isPartOf: { '@id': `${origin}/#website` }, about: { '@id': `${origin}/#business` }, inLanguage: 'en-GB' },
  ...(crumbs.length ? [{
    '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href ?? Astro.url.pathname, Astro.site).href })),
  }] : []),
  ...schema,
];
// `<` is escaped so no value can close the script element early.
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17355e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noSchema && <script type="application/ld+json" set:html={jsonld} />}
  </head>
  <body data-page={page}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!utility && <StickyCtaBar />}
    <WhatsAppFloat />
    <Lightbox />
    <script>
      // MOTION. Two patterns site-wide, both declarative:
      //   data-motion="reveal"  one-shot fade/rise when the element enters view
      //   data-motion="scrub"   scroll-linked: writes --progress (0..1) on the
      //                         element as it moves through the viewport
      // Everything respects prefers-reduced-motion. Nothing over 600ms.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveals = document.querySelectorAll<HTMLElement>('[data-motion="reveal"]');
      if (reduce) {
        reveals.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        reveals.forEach((el) => io.observe(el));
      }

      const scrubs = Array.from(document.querySelectorAll<HTMLElement>('[data-motion="scrub"]'));
      if (scrubs.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          const y = window.scrollY;
          scrubs.forEach((el) => {
            const r = el.getBoundingClientRect();
            const top = r.top + y;
            // Start clamped at scroll 0 so anything in view on load rests at 0
            // (otherwise the hero image is pre-shifted and the ground shows).
            const start = Math.max(0, top - vh);
            const end = top + r.height;
            const p = Math.min(1, Math.max(0, (y - start) / (end - start)));
            el.style.setProperty('--progress', p.toFixed(4));
          });
          ticking = false;
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      }

      // Pause marquees while off screen.
      const loops = document.querySelectorAll<HTMLElement>('[data-loop]');
      if (loops.length) {
        const lio = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.target as HTMLElement).toggleAttribute('data-paused', !e.isIntersecting));
        }, { rootMargin: '120px' });
        loops.forEach((el) => lio.observe(el));
      }

      // Header: floating pill, stronger shadow once scrolled.
      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const sync = () => header.toggleAttribute('data-stuck', window.scrollY > 24);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
      }

      // QUICK QUOTE ANCHOR LAW. Every Quick Quote link points at the form
      // itself (#quote). On mobile the form element lands with its fields
      // filling the viewport (scroll-margin keeps the first input under the
      // header); on desktop the whole quote section scrolls into view.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#quote"], a[href$="#quote"]');
        if (!a) return;
        const form = document.getElementById('quote');
        if (!form) {
          // Pages without a form (legal, utility): the contact page's form.
          e.preventDefault();
          location.href = '/contact/#quote';
          return;
        }
        const samePage = a.getAttribute('href') === '#quote' || a.pathname === location.pathname;
        if (!samePage) return;
        e.preventDefault();
        const mobile = window.innerWidth < 1024;
        const firstField = form.querySelector('input:not([type=hidden]), textarea, select') as HTMLElement | null;
        const target = mobile ? (firstField ?? form) : (form.closest('section') ?? form);
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        if (mobile && firstField) {
          // land the first input just under the header, not behind it
          setTimeout(() => {
            const top = firstField.getBoundingClientRect().top;
            const header = document.querySelector('[data-header]')?.getBoundingClientRect().bottom ?? 70;
            if (top < header + 12) window.scrollBy({ top: top - (header + 12), behavior: reduce ? 'auto' : 'smooth' });
          }, reduce ? 0 : 450);
        }
        history.replaceState(null, '', '#quote');
        setTimeout(() => form.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus({ preventScroll: true }), 650);
      });
    </script>
  </body>
</html>
