---
/**
 * Root layout. Head (noindex test build, canonical, OG, LocalBusiness +
 * WebSite + WebPage graph plus any page-level schema), header, footer, the one
 * root-mounted Lightbox, the mobile sticky bar, the motion wiring and the
 * Quick Quote anchor law.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import { business, services, seo } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  page?: string;
  utility?: boolean; // thank-you / 404: no sticky bar
  schema?: Record<string, unknown>[]; // extra @graph nodes
  ogImage?: string;
}
const { title = seo.title, description = seo.description, page = 'page', utility = false, schema = [], ogImage = '/images/new-20top-20image.jpg' } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Real NAP from his site. No aggregateRating: his site carries no reviews.
const graph: Record<string, unknown>[] = [
  {
    '@type': 'LocalBusiness',
    '@id': `${business.url}/#business`,
    name: business.name,
    description: seo.description,
    url: business.url,
    email: business.email,
    telephone: business.phone,
    image: ogImageUrl,
    foundingDate: String(business.founded),
    address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.town, addressRegion: business.region, postalCode: business.postcode, addressCountry: 'GB' },
    knowsAbout: services.map((s) => s.name),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Hot tubs, spas, saunas and servicing',
      itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } })),
    },
  },
  { '@type': 'WebSite', '@id': `${business.url}/#website`, url: business.url, name: business.name, publisher: { '@id': `${business.url}/#business` } },
  { '@type': 'WebPage', '@id': pageUrl, url: pageUrl, name: title, description, isPartOf: { '@id': `${business.url}/#website` }, about: { '@id': `${business.url}/#business` } },
  ...schema,
];
const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Client preview on workers.dev: never indexed. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1c2f4b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body data-page={page}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!utility && <StickyCtaBar />}
    <Lightbox />

    <script>
      // MOTION. Two patterns site-wide, both declarative:
      //   data-motion="reveal"  one-shot fade/rise when the element enters view
      //   data-motion="scrub"   scroll-linked: writes --progress (0..1) on the
      //                         element as it moves through the viewport
      // Everything respects prefers-reduced-motion. Nothing over 600ms.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveals = document.querySelectorAll<HTMLElement>('[data-motion="reveal"]');
      if (reduce) {
        reveals.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        reveals.forEach((el) => io.observe(el));
      }

      const scrubs = Array.from(document.querySelectorAll<HTMLElement>('[data-motion="scrub"]'));
      if (scrubs.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          const y = window.scrollY;
          scrubs.forEach((el) => {
            const r = el.getBoundingClientRect();
            const top = r.top + y;
            // Start clamped at scroll 0 so anything in view on load rests at 0
            // (otherwise the hero image is pre-shifted and the ground shows).
            const start = Math.max(0, top - vh);
            const end = top + r.height;
            const p = Math.min(1, Math.max(0, (y - start) / (end - start)));
            el.style.setProperty('--progress', p.toFixed(4));
          });
          ticking = false;
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      }

      // Pause marquees while off screen.
      const loops = document.querySelectorAll<HTMLElement>('[data-loop]');
      if (loops.length) {
        const lio = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.target as HTMLElement).toggleAttribute('data-paused', !e.isIntersecting));
        }, { rootMargin: '120px' });
        loops.forEach((el) => lio.observe(el));
      }

      // Header: floating pill, stronger shadow once scrolled.
      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const sync = () => header.toggleAttribute('data-stuck', window.scrollY > 24);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
      }

      // QUICK QUOTE ANCHOR LAW. Every Quick Quote link points at the form
      // itself (#quote). On mobile the form element lands with its fields
      // filling the viewport (scroll-margin keeps the first input under the
      // header); on desktop the whole quote section scrolls into view.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#quote"], a[href$="#quote"]');
        if (!a) return;
        const form = document.getElementById('quote');
        if (!form) {
          // Utility pages carry no form: the fallback is the homepage form.
          e.preventDefault();
          location.href = '/#quote';
          return;
        }
        const samePage = a.getAttribute('href') === '#quote' || a.pathname === location.pathname;
        if (!samePage) return;
        e.preventDefault();
        const mobile = window.innerWidth < 1024;
        const firstField = form.querySelector('input:not([type=hidden]), textarea, select');
        const target = mobile ? (firstField ?? form) : (form.closest('section') ?? form);
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        if (mobile && firstField) {
          // land the first input just under the header, not behind it
          setTimeout(() => {
            const top = firstField.getBoundingClientRect().top;
            const header = document.querySelector('[data-header]')?.getBoundingClientRect().bottom ?? 70;
            if (top < header + 12) window.scrollBy({ top: top - (header + 12), behavior: reduce ? 'auto' : 'smooth' });
          }, reduce ? 0 : 450);
        }
        history.replaceState(null, '', '#quote');
        const svc = a.dataset.service;
        const select = form.querySelector<HTMLSelectElement>('[data-service-select]');
        if (svc && select) select.value = svc;
        setTimeout(() => form.querySelector<HTMLInputElement>('input[name="name"]')?.focus({ preventScroll: true }), 650);
      });
    </script>
  </body>
</html>
