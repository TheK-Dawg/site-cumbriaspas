---
/**
 * CONTACT + QUOTE FORM (convert). The v3 closing slab: heading, the page's
 * own lead (law: the form copy talks about THAT page's service), the site's
 * call-to-action line and his NAP on the left; the white form card on the
 * right. No map here: the areas section above carries the page's one map.
 *
 * The form is Formlane (operator's form system), form
 * `cumbriaspas-quick-quote-online-form` ("Cumbria Spas — Quick Quote Online"),
 * Live, direct embed from api.formlane.uk, allowed on cumbriaspas.co.uk, www
 * and the preview2 workers.dev host. Fields (Formlane standard): name, email,
 * phone (below email), postcode, message. Leads go to the operator's
 * admin address only for now (brief, 5 Nov 2026). The embed token is public
 * and cannot read leads. The card keeps id="quote" so every Quick Quote
 * Online link lands on the fields; the section keeps id="contact".
 */
import { business, ctaLine } from '../data/site';
interface Props { heading: string; lead: string }
const { heading, lead } = Astro.props;
const FORM_ID = 'f_OTUvZjx2lNRyaokpaP6p';
const FORM_TOKEN = 'ERbIOFuK2Wzd0rMsINNflg';
---
<section class="qf section-contact" id="contact" data-section="contact">
  <div class="qf__slab slab on-dark">
    <div class="qf__inner container">
      <div class="qf__copy" data-motion="reveal">
        <h2 class="qf__h2">{heading}</h2>
        <p class="qf__p">{lead}</p>
        <p class="qf__cta">{ctaLine}</p>
        <ul class="qf__contact">
          <li>
            <span class="qf__k">Showroom</span>
            <span class="qf__v">{business.street}<br />{business.town}, {business.region}<br />{business.postcode}</span>
          </li>
          <li>
            <span class="qf__k">Call now</span>
            <a class="qf__v" href={business.phoneHref}>{business.phone}</a>
          </li>
          <li>
            <span class="qf__k">WhatsApp</span>
            <a class="qf__v" href={business.whatsapp} target="_blank" rel="noopener">Message {business.phone}</a>
          </li>
          <li>
            <span class="qf__k">Email</span>
            <span class="qf__v">{business.email}</span>
          </li>
        </ul>
      </div>

      <div class="qf__card on-light" id="quote" data-quote-card>
        <h3 class="qf__form-h">Quick Quote Online</h3>
        <p class="qf__form-p">Send the form and Cumbria Spas will come back to you.</p>
        <div class="qf__slot" data-lead-form={FORM_ID} data-lf-token={FORM_TOKEN}>
          <noscript><p class="qf__note">The quote form needs JavaScript. Call {business.phone} or message on WhatsApp instead.</p></noscript>
        </div>
      </div>
    </div>
  </div>
</section>
<script is:inline src="https://api.formlane.uk/edge/form.js" defer></script>

<style>
  .qf { padding: 0 0 var(--inset); background: var(--page); }
  .qf__slab { background: linear-gradient(115deg, var(--teal-ink) 0%, var(--teal-deep) 50%, var(--teal) 100%); color: var(--on-dark); padding: var(--pad-med) 0; position: relative; overflow: hidden; }
  .qf__slab::before { content: ''; position: absolute; left: -80px; top: -80px; width: 320px; height: 320px; border-radius: 50%; background: rgb(255 255 255 / 0.07); pointer-events: none; }
  .qf__inner { display: grid; grid-template-columns: 1fr 480px; gap: 48px 72px; align-items: start; position: relative; }
  .qf__h2 { font-size: var(--text-2xl); max-width: 20ch; margin-bottom: 16px; text-wrap: balance; }
  .qf__p { color: var(--muted-dark); line-height: 1.6; max-width: 52ch; margin-bottom: 14px; }
  .qf__cta { font-weight: 700; margin-bottom: 28px; }
  .qf__contact { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, auto)); gap: 22px 40px; justify-content: start; }
  .qf__contact li { display: flex; flex-direction: column; gap: 6px; }
  .qf__k { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sky); }
  .qf__v { font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
  a.qf__v:hover { color: var(--sky); }

  .qf__card {
    background: var(--card); color: var(--on-light); border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 32px); display: grid; gap: 10px;
    box-shadow: 0 30px 80px rgb(15 26 43 / 0.35);
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
  .qf__form-h { font-size: 1.375rem; font-weight: 800; letter-spacing: -0.015em; color: var(--teal-deep); }
  .qf__form-p { font-size: 0.9375rem; color: var(--muted-light); }
  .qf__slot { min-height: 360px; }
  .qf__note { font-size: 0.9375rem; color: var(--muted-light); }
  @media (max-width: 1080px) { .qf__inner { grid-template-columns: 1fr; } .qf__card { max-width: 560px; } }
  @media (max-width: 640px) {
    .qf__contact { grid-template-columns: 1fr; }
    .qf__card { padding: 18px; scroll-margin-top: calc(var(--header-h) + 4px); }
  }
</style>
