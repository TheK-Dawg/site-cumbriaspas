---
/**
 * LEGAL / UTILITY PAGE SHELL. A short teal slab head (single H1) over a prose
 * column. Used by terms, privacy and the thank-you page.
 */
interface Props { h1: string; lead?: string; kind?: string }
const { h1, lead, kind = 'legal' } = Astro.props;
---
<section class={`lp section-${kind} on-light`} data-section={kind}>
  <div class="lp__head slab on-dark" data-hero-watch>
    <div class="container">
      <h1 class="lp__h1">{h1}</h1>
      {lead && <p class="lp__lead">{lead}</p>}
    </div>
  </div>
  <div class="container lp__body prose">
    <slot />
  </div>
</section>

<style>
  .lp { background: var(--page); padding: 0 0 var(--pad-med); }
  .lp__head { background: linear-gradient(160deg, var(--teal-ink) 0%, var(--teal-deep) 60%, var(--teal) 100%); color: var(--on-dark); padding: calc(var(--header-h) + 56px) 0 56px; border-top-left-radius: 0; border-top-right-radius: 0; }
  .lp__h1 { font-size: var(--text-2xl); max-width: 18ch; text-wrap: balance; }
  .lp__lead { color: var(--muted-dark); max-width: 56ch; margin-top: 14px; font-size: var(--text-lg); }
  .lp__body { padding-top: 48px; }
  .lp__body :global(h2) { color: var(--teal-deep); }
  @media (min-width: 761px) { .lp__head { margin-inline: var(--inset); border-radius: 0 0 var(--radius-xl) var(--radius-xl); } }
</style>
