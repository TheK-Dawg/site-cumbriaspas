---
/**
 * FLOATING WHATSAPP BUTTON (plan): click-to-chat in the bottom-right corner
 * of every page, on phones only. Hidden completely from 768px up (operator,
 * 5 Nov 2026: people can't use WhatsApp on desktop). On phones it rides above
 * the sticky Quick Quote / Call bar so the two never overlap.
 */
import { business } from '../data/site';
---
<a class="wa" href={business.whatsapp} target="_blank" rel="noopener" data-cta="whatsapp-float" aria-label={`WhatsApp ${business.name} on ${business.phone}`}>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.5c0 2.4.7 4.7 2 6.7L3 29l7-2.2c1.9 1 4 1.6 6 1.6 7 0 12.7-5.6 12.7-12.6S23 3 16 3zm0 23c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.1 1.3 1.3-4-.3-.4a10 10 0 0 1-1.6-5.5C5.5 9.9 10.2 5.3 16 5.3S26.5 9.9 26.5 15.6 21.8 26 16 26zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.8 1.1 3.3.9 3.9.8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.7-.4z"/></svg>
  <span class="wa__label">WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed; right: 18px; bottom: 18px; z-index: 86;
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 56px; padding: 0 20px 0 14px; border-radius: var(--pill);
    background: #146c3e; color: #ffffff; font-weight: 700; font-size: 0.9375rem;
    box-shadow: 0 12px 30px rgb(10 18 31 / 0.28);
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .wa:hover, .wa:focus-visible { background: #0f5a33; transform: translateY(-2px); }
  /* Desktop and tablet: not rendered at all. */
  @media (min-width: 768px) { .wa { display: none; } }
  /* Phones: an icon-only circle above the sticky bar. */
  @media (max-width: 767px) {
    .wa { right: 12px; bottom: calc(84px + env(safe-area-inset-bottom)); width: 56px; height: 56px; padding: 0; justify-content: center; }
    .wa__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { .wa, .wa:hover { transition: none; transform: none; } }
</style>
