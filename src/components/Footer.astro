---
/**
 * FOOTER (route, rest). The v3 deep-blue slab. Brand (LAW: his logo image,
 * never a text wordmark) + the approved manufacturer line + NAP; every hub;
 * every other built page (Resources included: operator, 5 Nov 2026); a
 * "More" group (FAQ, areas, gallery, sitemap, legal). Law: the
 * footer links every built page, the year is automatic, and there is NO call
 * to action in the footer. The email is shown as text only: the mailbox is
 * not live yet. Bottom bar: copyright + the one-link footer credit.
 */
import FooterCredit from './FooterCredit.astro';
import { business, hubs, hubHref, pages, manufacturerLine } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="ft__slab slab on-dark">
    <div class="ft__inner container">
      <div class="ft__grid">
        <div class="ft__brand">
          <a href="/" class="ft__logo" aria-label={`${business.name}, home`}>
            <img src="/images/square.jpg" alt={business.name} width="96" height="96" loading="lazy" decoding="async" />
          </a>
          <p class="ft__tag">Hot tubs, spas, saunas, pools and hot tub servicing, established in {business.founded}. {manufacturerLine}</p>
          <ul class="ft__nap">
            <li><span class="ft__k">Address</span><span>{business.address}</span></li>
            <li><span class="ft__k">Phone</span><a href={business.phoneHref}>{business.phone}</a></li>
            <li><span class="ft__k">WhatsApp</span><a href={business.whatsapp} target="_blank" rel="noopener">{business.phone} on WhatsApp</a></li>
            <li><span class="ft__k">Email</span><span>{business.email}</span></li>
          </ul>
        </div>
        <div class="ft__col">
          <p class="ft__h">Services</p>
          <ul>
            {hubs.map((h) => <li><a href={hubHref(h.slug)}>{h.name}</a></li>)}
          </ul>
        </div>
        <div class="ft__col">
          <p class="ft__h">Cumbria Spas</p>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href={pages.services.href}>All services</a></li>
            <li><a href={pages.chemicals.href}>Hot tub chemicals</a></li>
            <li><a href={pages.parts.href}>Hot tub parts</a></li>
            <li><a href={pages.about.href}>About Cumbria Spas</a></li>
            <li><a href={pages.reviews.href}>Reviews</a></li>
            <li><a href={pages.resources.href}>Resources</a></li>
            <li><a href={pages.contact.href}>Contact</a></li>
          </ul>
        </div>
        <div class="ft__col">
          <p class="ft__h">More</p>
          <ul>
            <li><a href={pages.faq.href}>FAQ</a></li>
            <li><a href={pages.areas.href}>Areas covered</a></li>
            <li><a href={pages.gallery.href}>Gallery</a></li>
            <li><a href={pages.sitemap.href}>Sitemap</a></li>
            <li><a href={pages.terms.href}>Terms and Conditions</a></li>
            <li><a href={pages.privacy.href}>Privacy Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="ft__meta">
        <p>&copy; {year} {business.name}</p>
        <FooterCredit />
      </div>
    </div>
  </div>
</footer>

<style>
  .ft { padding: 0 0 var(--inset); background: var(--page); }
  .ft__slab { background: var(--teal-deep); color: var(--on-dark); padding: clamp(40px, 5vw, 64px) 0 28px; overflow: hidden; }
  .ft__grid { display: grid; grid-template-columns: 1.5fr 1.1fr 0.9fr 0.8fr; gap: 36px 40px; align-items: start; }
  /* His logo is a white-ground JPG: it sits on its own white rounded tile on the deep blue. */
  .ft__logo { display: inline-block; background: #fff; border-radius: var(--radius); padding: 6px; margin-bottom: 18px; }
  .ft__logo img { width: 84px; height: 84px; object-fit: contain; }
  .ft__tag { color: var(--muted-dark); max-width: 44ch; font-size: 0.9375rem; margin-bottom: 18px; }
  .ft__nap { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 0.9375rem; }
  .ft__nap li { display: grid; grid-template-columns: 84px 1fr; gap: 12px; }
  .ft__k { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky); padding-top: 3px; }
  .ft__nap a { font-weight: 600; }
  .ft__nap a:hover { color: var(--sky); }
  .ft__h { font-weight: 700; margin-bottom: 14px; font-size: 1rem; }
  .ft__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; font-size: 0.9375rem; }
  .ft__col a { color: var(--muted-dark); }
  .ft__col a:hover { color: var(--sky); }
  .ft__meta { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--line-dark); font-size: 0.875rem; color: var(--muted-dark); }
  @media (max-width: 1080px) { .ft__grid { grid-template-columns: 1fr 1fr; } .ft__brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ft__grid { grid-template-columns: 1fr; } .ft__nap li { grid-template-columns: 1fr; gap: 2px; } }
</style>
