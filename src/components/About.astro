---
/**
 * ABOUT (prove). The v3 about mosaic: photo with an overlapping white card on
 * the left, a brand-blue statement panel with tag chips on the right. His own
 * home-page words only.
 */
interface Props {
  heading: string;
  lead: string;
  cardTitle: string;
  cardBody: string[];
  panelHeading: string;
  chips: string[];
  image: string;
  imageAlt: string;
}
const { heading, lead, cardTitle, cardBody, panelHeading, chips, image, imageAlt } = Astro.props;
---
<section class="ab section-about on-light" id="about" data-section="about">
  <div class="container">
    <div class="sh" data-motion="reveal">
      <div><h2 class="sh__h2">{heading}</h2></div>
      <p class="sh__lead">{lead}</p>
    </div>
    <div class="ab__grid">
      <div class="ab__left" data-motion="reveal">
        <figure class="ab__photo">
          <img src={image} alt={imageAlt} width="630" height="471" loading="lazy" decoding="async" />
        </figure>
        <div class="ab__card">
          <h3 class="ab__card-h">{cardTitle}</h3>
          {cardBody.map((p) => <p class="ab__card-p">{p}</p>)}
          <a href="#quote" class="btn btn-teal ab__card-btn" data-cta="about-quote">Quick Quote Online</a>
        </div>
      </div>
      <div class="ab__panel on-dark" data-motion="reveal" style="--reveal-delay: 80ms">
        <h3 class="ab__panel-h">{panelHeading}</h3>
        <ul class="ab__chips">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ab { padding: var(--pad-med) 0; background: var(--page); }
  .ab__grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; align-items: stretch; }
  .ab__left { display: grid; grid-template-columns: 320px 1fr; align-items: end; }
  .ab__photo { margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 5; max-height: 460px; }
  .ab__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 55% center; }
  .ab__card { background: var(--card); border-radius: var(--radius-lg); padding: 30px 30px 30px 34px; margin-left: -40px; margin-bottom: 30px; box-shadow: var(--shadow-card); position: relative; }
  .ab__card-h { font-size: var(--text-xl); margin-bottom: 12px; color: var(--teal-deep); }
  .ab__card-p { color: var(--muted-light); font-size: 0.9375rem; line-height: 1.6; margin-bottom: 14px; max-width: 48ch; }
  .ab__card-btn { margin-top: 4px; }
  .ab__panel { background: var(--teal); color: var(--on-dark); border-radius: var(--radius-lg); padding: 34px; display: flex; flex-direction: column; justify-content: space-between; gap: 30px; position: relative; overflow: hidden; }
  .ab__panel::before { content: ''; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: rgb(79 170 223 / 0.22); }
  .ab__panel-h { font-size: var(--text-xl); max-width: 16ch; text-wrap: balance; position: relative; }
  .ab__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; position: relative; }
  .ab__chips li { background: var(--sky); color: var(--on-sky); border-radius: var(--pill); padding: 9px 14px; font-size: 0.875rem; font-weight: 600; }
  @media (max-width: 1080px) { .ab__grid { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    .ab__left { grid-template-columns: 1fr; }
    .ab__photo { max-height: 300px; aspect-ratio: 4 / 3; }
    .ab__card { margin: -30px 16px 0; padding: 24px; }
  }
</style>
