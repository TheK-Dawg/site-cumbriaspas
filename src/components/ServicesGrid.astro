---
/**
 * SERVICES (route). The v3 pale-tint rounded cards, three across, photo
 * inside the card: the nine hubs in the seed's order. LAW: the TITLE is the
 * only link (the exact service name, to its page); the card box, photo and
 * text are not clickable.
 */
import { hubs, hubHref } from '../data/site';
import { pick } from '../lib/media';
interface Props { heading: string; lead: string; id?: string }
const { heading, lead, id = 'services' } = Astro.props;
---
<section class="sv section-services on-light" id={id} data-section="services">
  <div class="container">
    <div class="sh" data-motion="reveal">
      <div><h2 class="sh__h2">{heading}</h2></div>
      <p class="sh__lead">{lead}</p>
    </div>
    <ul class="sv__grid">
      {hubs.map((h, i) => {
        const im = pick(h.slug, 0);
        return (
          <li class="sv__card" data-motion="reveal" style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <div class="sv__media">
              <img src={im.src} alt={im.alt} width={im.w ?? 1200} height={im.h ?? 900} loading="lazy" decoding="async" />
            </div>
            <div class="sv__body">
              <h3 class="sv__title"><a href={hubHref(h.slug)}>{h.name}</a></h3>
              <p class="sv__text">{h.blurb}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .sv { padding: var(--pad-med) 0; background: var(--page); }
  .sv__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .sv__card { display: flex; flex-direction: column; background: var(--tint); border-radius: var(--radius-lg); padding: 12px 12px 0; overflow: hidden; }
  .sv__media { border-radius: calc(var(--radius-lg) - 8px); overflow: hidden; aspect-ratio: 4 / 3; background: var(--tint-2); }
  .sv__media img { width: 100%; height: 100%; object-fit: cover; }
  .sv__body { display: flex; flex-direction: column; flex: 1; padding: 20px 14px 22px; }
  .sv__title { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.015em; margin-bottom: 10px; }
  .sv__title a { color: var(--teal-deep); text-decoration: none; transition: color 0.2s var(--ease); }
  .sv__title a:hover, .sv__title a:focus-visible { color: var(--sky-deep); }
  .sv__text { color: var(--muted-light); font-size: 0.9375rem; line-height: 1.55; }
  @media (max-width: 980px) { .sv__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (max-width: 600px) {
    .sv__grid { grid-template-columns: 1fr; gap: 12px; }
    .sv__card { display: grid; grid-template-columns: 104px 1fr; align-items: center; padding: 10px; gap: 12px; }
    .sv__media { aspect-ratio: 1 / 1; border-radius: var(--radius); }
    .sv__body { padding: 4px 4px 4px 0; }
    .sv__title { font-size: 1.0625rem; margin-bottom: 4px; }
    .sv__text { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.8125rem; }
  }
</style>
