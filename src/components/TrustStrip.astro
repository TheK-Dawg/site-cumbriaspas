---
/**
 * TRUST STRIP (prove). Takes the reviews band's slot under every hero: the
 * business has no reviews yet (seed.reviews "none-yet"), so four verifiable
 * facts sit in a white card overlapping the hero foot. No brand logos (the
 * operator removed the "Brands we sell" badges, 5 Nov 2026).
 */
import { trustFacts } from '../data/site';
interface Item { k: string; v: string }
interface Props { items?: Item[] }
const { items = trustFacts } = Astro.props;
---
<section class="ts section-trust on-light" data-section="trust">
  <div class="container">
    <div class="ts__card" data-motion="reveal">
      <ul class="ts__list">
        {items.map((i) => (
          <li class="ts__item">
            <span class="ts__k">{i.k}</span>
            <span class="ts__v">{i.v}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ts { background: var(--page); padding: 12px 0 0; }
  .ts__card { background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); padding: 26px 30px; }
  .ts__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 28px; }
  .ts__item { display: flex; flex-direction: column; gap: 4px; }
  .ts__k { font-size: 1.1875rem; font-weight: 800; color: var(--teal-deep); letter-spacing: -0.015em; line-height: 1.2; }
  .ts__v { font-size: 0.875rem; color: var(--muted-light); line-height: 1.4; }
  @media (max-width: 760px) { .ts__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ts__card { padding: 22px 20px; } }
</style>
