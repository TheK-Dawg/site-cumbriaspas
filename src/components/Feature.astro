---
/**
 * FEATURE ROW (explain). The v3 alternating image/copy row: a large rounded
 * photo with an optional photo inset on one side, H2, body (may carry inline
 * links), a tint card list of points and the CTA on the other. No logo insets
 * (operator, 5 Nov 2026: no brand-logo pictures). `flip`
 * puts the photo on the right. `tone="tint"` sits the row on the ice-blue
 * slab so consecutive features read as separate bands.
 */
interface Point { h: string; p: string }
interface Props {
  id: string;
  heading: string;
  body: string[];
  image: string;
  imageAlt: string;
  full?: string;
  imagePos?: string;
  inset?: string;
  insetAlt?: string;
  insetKind?: 'photo';
  points?: Point[];
  note?: string;
  cta?: string;
  service?: string;
  flip?: boolean;
  tone?: 'page' | 'tint';
}
const { id, heading, body, image, imageAlt, full, imagePos = 'center', inset, insetAlt = '', insetKind = 'photo', points = [], note, cta = 'Quick Quote Online', service, flip = false, tone = 'page' } = Astro.props;
---
<section class:list={['ft-row', `section-${id}`, 'on-light', tone === 'tint' && 'ft-row--tint']} id={id} data-section={id}>
  <div class:list={['ft-row__slab', tone === 'tint' && 'slab']}>
    <div class:list={['container', 'ft-row__grid', flip && 'ft-row__grid--flip']}>
      <div class="ft-row__media" data-motion="reveal">
        <figure class="ft-row__photo">
          <img src={image} data-full={full ?? image} alt={imageAlt} width="1000" height="1100" loading="lazy" decoding="async" style={`object-position: ${imagePos}`} />
        </figure>
        {inset && (
          <div class:list={['ft-row__inset', `ft-row__inset--${insetKind}`]}>
            <img src={inset} alt={insetAlt} loading="lazy" decoding="async" />
          </div>
        )}
      </div>
      <div class="ft-row__copy" data-motion="reveal" style="--reveal-delay: 80ms">
        <h2 class="ft-row__h2">{heading}</h2>
        {body.map((p) => <p class="ft-row__p" set:html={p} />)}
        {points.length > 0 && (
          <ul class="ft-row__points">
            {points.map((pt) => (
              <li>
                <h3>{pt.h}</h3>
                <p>{pt.p}</p>
              </li>
            ))}
          </ul>
        )}
        {note && <p class="ft-row__note">{note}</p>}
        <div class="btn-row">
          <a href="#quote" class="btn btn-primary" data-cta={`${id}-quote`} data-service={service}>{cta}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ft-row { background: var(--page); padding: var(--pad-med) 0; }
  .ft-row--tint { padding: 0 0 var(--inset); }
  .ft-row--tint .ft-row__slab { background: var(--tint); padding: var(--pad-med) 0; }
  .ft-row__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px 72px; align-items: center; }
  .ft-row__grid--flip .ft-row__media { order: 2; }
  .ft-row__media { position: relative; padding-bottom: 28px; }
  .ft-row__photo { margin: 0; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 5 / 5.4; background: var(--tint-2); box-shadow: var(--shadow-float); }
  .ft-row__photo img { width: 100%; height: 100%; object-fit: cover; }
  .ft-row__inset { position: absolute; bottom: 0; right: -18px; background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow-float); padding: 16px 20px; max-width: 46%; }
  .ft-row__grid--flip .ft-row__inset { right: auto; left: -18px; }
  .ft-row__inset img { width: 100%; height: auto; mix-blend-mode: multiply; }
  .ft-row__inset--photo { padding: 8px; max-width: 40%; }
  .ft-row__inset--photo img { border-radius: var(--radius); mix-blend-mode: normal; }
  .ft-row__h2 { font-size: var(--text-2xl); max-width: 20ch; text-wrap: balance; margin-bottom: 18px; color: var(--teal-deep); }
  .ft-row__p { color: var(--muted-light); max-width: 56ch; margin-bottom: 14px; }
  .ft-row__p :global(a) { color: var(--teal); font-weight: 700; }
  .ft-row__p :global(a:hover) { color: var(--sky-deep); }
  .ft-row__points { list-style: none; margin: 22px 0 18px; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ft-row__points li { background: var(--card); border-radius: var(--radius); padding: 16px 18px; box-shadow: 0 4px 16px rgb(28 47 75 / 0.06); }
  .ft-row--tint .ft-row__points li { background: var(--card); }
  .ft-row__points h3 { font-size: 1rem; font-weight: 800; color: var(--teal-deep); margin-bottom: 4px; letter-spacing: -0.01em; }
  .ft-row__points p { font-size: 0.875rem; color: var(--muted-light); line-height: 1.5; }
  .ft-row__note { font-size: 0.9375rem; font-weight: 600; color: var(--teal); margin-bottom: 22px; }
  .ft-row__copy .btn-row { margin-top: 8px; }
  @media (max-width: 960px) {
    .ft-row__grid { grid-template-columns: 1fr; gap: 32px; }
    .ft-row__grid--flip .ft-row__media { order: 0; }
    .ft-row__photo { aspect-ratio: 4 / 3; }
    .ft-row__inset, .ft-row__grid--flip .ft-row__inset { right: 12px; left: auto; }
  }
  @media (max-width: 520px) { .ft-row__points { grid-template-columns: 1fr; } .ft-row__inset { max-width: 58%; padding: 12px 14px; } .ft-row__inset--photo { max-width: 44%; padding: 6px; } }
</style>
