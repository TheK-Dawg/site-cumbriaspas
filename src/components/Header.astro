---
/**
 * Header. The v3 floating white pill inside the hero: his logo alone left
 * (the stacked square.jpg wordmark from the approved preview 2), the nav
 * centre with a Services dropdown listing every hub plus Chemicals and Parts
 * (content law), his phone number + Quick Quote Online pill right. Fixed,
 * gains a stronger shadow once scrolled. Below 1240px the nav folds into the
 * burger but the phone and quote stay in the bar; phones (<=640px) show the
 * logo and burger only, with call + quote in the opened menu and the sticky bar.
 */
import { business, nav, hubs, hubHref, pages } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const serviceLinks = [...hubs.map((h) => ({ label: h.name, href: hubHref(h.slug) })), { label: 'Chemicals', href: pages.chemicals.href }, { label: 'Parts', href: pages.parts.href }];
const isService = hubs.some((h) => path.startsWith(hubHref(h.slug))) || path.startsWith('/services/');
---

<header class="hd" data-header>
  <div class="hd__wrap container">
    <div class="hd__row">
      <a href="/" class="hd__brand" aria-label={`${business.name}, home`}>
        <img class="hd__logo" src="/images/square.jpg" alt="" width="56" height="56" />
      </a>

      <nav class="hd__nav" aria-label="Main">
        {nav.filter((item) => item.label !== 'Chemicals' && item.label !== 'Parts').map((item) => item.dropdown ? (
          <div class="hd__dd" data-dd>
            <a href={item.href} class="hd__link hd__link--dd" aria-current={isService ? 'page' : undefined} aria-haspopup="true">{item.label}<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <div class="hd__dd-panel">
              <ul>
                {serviceLinks.map((l) => <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
              </ul>
            </div>
          </div>
        ) : (
          <a href={item.href} class="hd__link" aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <div class="hd__right">
        <a href={business.phoneHref} class="hd__phone" data-cta="header-call">{business.phone}</a>
        <a href="#quote" class="btn btn-primary hd__quote" data-cta="header-quote">Quick Quote Online</a>
      </div>

      <button class="hd__burger" type="button" data-burger aria-label="Open menu" aria-expanded="false" aria-controls="hd-menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="hd__menu" id="hd-menu" data-menu hidden>
      <nav class="hd__menu-nav" aria-label="Mobile">
        {nav.filter((item) => !item.dropdown).map((item) => <a href={item.href} class="hd__menu-link" aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <p class="hd__menu-h">Services</p>
        {hubs.map((h) => <a href={hubHref(h.slug)} class="hd__menu-link hd__menu-link--sub" aria-current={current(hubHref(h.slug)) ? 'page' : undefined}>{h.name}</a>)}
      </nav>
      <div class="hd__menu-actions">
        <a href="#quote" class="btn btn-primary" data-cta="menu-quote">Quick Quote Online</a>
        <a href={business.phoneHref} class="btn btn-ghost-ink" data-cta="menu-call">Call {business.phone}</a>
      </div>
    </div>
  </div>
  <div class="hd__scrim" data-scrim hidden></div>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto 0; z-index: 90; color: var(--on-light); pointer-events: none; }
  .hd__wrap { padding-top: 14px; transition: padding 0.3s var(--ease); }
  .hd[data-stuck] .hd__wrap { padding-top: 8px; }
  .hd__row {
    pointer-events: auto;
    display: flex; align-items: center; gap: 28px; height: 64px;
    padding: 0 10px 0 18px; border-radius: var(--pill);
    background: #ffffff; isolation: isolate; box-shadow: 0 8px 30px rgb(37 60 94 / 0.14);
    transition: box-shadow 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .hd[data-stuck] .hd__row { box-shadow: 0 10px 34px rgb(37 60 94 / 0.22); }
  .hd__brand { display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0; line-height: 1; }
  /* His logo is a white-ground JPG: multiply drops the white into the header bar, no frame. */
  .hd__logo { width: 56px; height: 56px; object-fit: contain; mix-blend-mode: multiply; }
  .hd__nav { display: flex; gap: 20px; font-size: 0.9375rem; font-weight: 600; margin-left: auto; }
  .hd__phone { font-weight: 700; font-size: 0.9375rem; color: var(--teal); margin-right: 16px; white-space: nowrap; }
  .hd__phone:hover { color: var(--sky-deep); }
  .hd__link { color: rgb(13 29 39 / 0.82); padding: 6px 0; transition: color 0.2s var(--ease); }
  .hd__link:hover, .hd__link[aria-current='page'] { color: var(--sky-deep); }
  .hd__right { display: flex; align-items: center; }
  .hd__nav { align-items: center; }
  .hd__link--dd { display: inline-flex; align-items: center; gap: 5px; }
  .hd__dd { position: relative; }
  .hd__dd-panel {
    position: absolute; left: -18px; top: 100%; padding-top: 16px; min-width: 290px;
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0s linear 0.2s;
  }
  .hd__dd:hover .hd__dd-panel, .hd__dd:focus-within .hd__dd-panel { opacity: 1; visibility: visible; transform: none; transition: opacity 0.2s var(--ease), transform 0.2s var(--ease); }
  .hd__dd-panel ul { list-style: none; margin: 0; padding: 10px; background: #ffffff; border-radius: var(--radius-lg); box-shadow: 0 18px 44px rgb(37 60 94 / 0.2); display: grid; gap: 2px; }
  .hd__dd-panel a { display: block; padding: 9px 14px; border-radius: var(--radius); font-size: 0.9375rem; font-weight: 600; color: var(--teal-deep); white-space: nowrap; }
  .hd__dd-panel a:hover, .hd__dd-panel a:focus-visible, .hd__dd-panel a[aria-current='page'] { background: var(--tint); color: var(--sky-deep); }
  .hd__menu-h { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-light); padding: 16px 4px 4px; }
  .hd__menu-link--sub { font-size: 1rem; font-weight: 600; padding: 10px 4px; }
  .hd__quote { min-height: 46px; padding: 11px 22px; font-size: 0.875rem; }

  .hd__burger {
    display: none; margin-left: auto; width: 44px; height: 44px; padding: 0;
    background: none; border: 0; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 6px;
  }
  .hd__burger span { display: block; width: 24px; height: 2px; border-radius: 2px; background: var(--teal-deep); transition: transform 0.25s var(--ease), opacity 0.2s; }
  .hd__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .hd__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hd__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* The mobile menu drops straight out of the header bar: same container,
     same width and inset, squared seam, rounded foot. A scrim dims the page. */
  .hd__menu {
    pointer-events: auto;
    display: none; flex-direction: column; gap: 20px;
    max-height: calc(100dvh - var(--header-h) - 16px); overflow-y: auto; overscroll-behavior: contain;
    background: #ffffff;
    border-top: 1px solid var(--line-light);
    border-radius: 0 0 28px 28px;
    padding: 4px 18px 20px;
    box-shadow: 0 24px 40px rgb(37 60 94 / 0.22);
  }
  .hd[data-open] .hd__row { border-radius: 30px 30px 0 0; box-shadow: none; background: #ffffff; }
  .hd__menu-nav { display: flex; flex-direction: column; }
  .hd__menu-link { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; padding: 13px 4px; border-bottom: 1px solid var(--line-light); color: var(--teal-deep); }
  .hd__menu-link:last-child { border-bottom: 0; }
  .hd__menu-link[aria-current='page'] { color: var(--sky-deep); }
  .hd__menu-actions { display: flex; flex-direction: column; gap: 10px; }
  .hd__menu-actions .btn { width: 100%; }
  .hd__scrim { position: fixed; inset: 0; z-index: -1; background: rgb(10 18 31 / 0.45); pointer-events: auto; }
  .hd__scrim[hidden] { display: none; }

  @media (max-width: 1239px) {
    .hd__nav { display: none; }
    .hd__right { margin-left: auto; }
    .hd__burger { display: flex; margin-left: -12px; }
    .hd__menu:not([hidden]) { display: flex; }
  }
  @media (max-width: 1023px) {
    .hd__wrap { padding-top: 10px; }
    .hd__row { height: 60px; padding-left: 18px; }
    /* Logo sits fully inside the pill's rounded end on tablet/phone. */
    .hd__logo { width: 48px; height: 48px; }
  }
  @media (max-width: 640px) {
    .hd__right { display: none; }
    .hd__burger { margin-left: auto; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const scrim = header?.querySelector<HTMLElement>('[data-scrim]');
  if (header && burger && menu) {
    const set = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      if (scrim) scrim.hidden = !open;
      header.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    scrim?.addEventListener('click', () => set(false));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    window.addEventListener('resize', () => { if (window.innerWidth >= 1240) set(false); });
  }
</script>
